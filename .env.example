# Copy to .env (git-ignored) and adjust. `shiksha` reads .env from its working directory.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/shiksha?sslmode=disable
# required: 32+ random bytes, e.g. openssl rand -base64 48
JWT_SECRET=
HTTP_ADDR=:8080
ADMIN_ADDR=:9090
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Leave SMTP_HOST empty in development: reset emails are then written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Shiksha AI <no-reply@example.com>
# Speech and language providers. "fake" simulates them (no keys, no network); "real" uses
# Bhashini (ASR/TTS) and Gemini and needs the keys below. Never commit real keys.
PROVIDERS=fake
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_TEMPERATURE=
# ENABLED_LANGUAGES=hi,mr,bn,ta,te,gu,kn,ml,en
# PROVIDER_MAX_CONCURRENCY=64
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
