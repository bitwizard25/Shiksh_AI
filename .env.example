# Copy to .env (git-ignored) and adjust. `shiksha` reads .env from its working directory.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/shiksha?sslmode=disable
# required: 32+ random bytes, e.g. openssl rand -base64 48
JWT_SECRET=
HTTP_ADDR=:8080
ADMIN_ADDR=:9090
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Public WebSocket URL returned to clients with a session ticket (the realtime endpoint arrives in Plan 4).
WS_URL=ws://localhost:8080/v1/ws
WS_TICKET_TTL=60s
# A session idle this long is ended by the worker role; SWEEP_INTERVAL is how often it looks.
SESSION_RESUME_GRACE=5m
SWEEP_INTERVAL=60s
# Leave SMTP_HOST empty in development: reset emails are then written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Shiksha AI <no-reply@example.com>
